# Copy this file to .env and load the environment with your shell or deployment system.
# NEVER commit real credentials. Start with: node --env-file=.env server/index.js
HOST=127.0.0.1
PORT=4173
DATA_FILE=./data/inbound.json
ADMIN_API_TOKEN=replace-with-long-random-secret-for-admin-inbox
WEBSITE_API_KEY=replace-with-long-random-secret-for-server-to-server-website-posts
META_VERIFY_TOKEN=replace-with-random-meta-webhook-verification-token
META_APP_SECRET=replace-with-meta-app-secret
